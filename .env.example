# Environment Variables for A2A Multi-Agent Application
# Copy this file to .env and fill in your values

# ============================================================================
# FOR LOCAL TESTING & DEVELOPMENT
# ============================================================================

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex AI (recommended)
GOOGLE_GENAI_USE_VERTEXAI=1

# ML Dev backend config (only if GOOGLE_GENAI_USE_VERTEXAI=0)
GOOGLE_API_KEY=your-api-key-here

# Vertex AI backend config (recommended for production)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Project Information
# Get this with: gcloud projects describe YOUR_PROJECT_ID --format="value(projectNumber)"
PROJECT_NUMBER=your-project-number

# MCP Server Configuration
# These will be used to construct the full URLs after deployment
COCKTAIL_REMOTE_MCP_SERVER_NAME=cocktail-remote-mcp-server-adk-mb
WEATHER_REMOTE_MCP_SERVER_NAME=weather-remote-mcp-server-adk-mb

# ============================================================================
# FOR DEPLOYMENT (set these after deploying MCP servers)
# ============================================================================

# MCP Server URLs (generated after deploying to Cloud Run)
# Format: https://SERVICE_NAME-PROJECT_NUMBER.REGION.run.app/mcp/sse
# CT_MCP_SERVER_URL=https://cocktail-remote-mcp-server-adk-mb-PROJECT_NUMBER.us-central1.run.app/mcp/sse
# WEA_MCP_SERVER_URL=https://weather-remote-mcp-server-adk-mb-PROJECT_NUMBER.us-central1.run.app/mcp/sse

# Agent Engine ID (generated after deploying agents)
# AGENT_ENGINE_ID=your-hosting-agent-id

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Model selection
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Bucket for storage (if needed)
# BUCKET_NAME=your-bucket-name

# Region configuration
GOOGLE_CLOUD_REGION=us-central1